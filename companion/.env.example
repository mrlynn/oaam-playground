# Copy to companion/.env. Inside this repo it's optional: anything missing is
# read from agent/.env and infra/.env (AIM_LIVE_PASSWORD, ANTHROPIC_API_KEY, ...).
# COMPANION_DB_USER=aim_live            # real conversations; never reset
# COMPANION_DB_PASSWORD=                # default: <DB_USER>_PASSWORD, e.g. AIM_LIVE_PASSWORD
# COMPANION_DB_DSN=localhost:1521/FREEPDB1
# COMPANION_LLM_MODEL=anthropic/claude-sonnet-5
# COMPANION_EMBED_MODEL=ollama/nomic-embed-text
# COMPANION_USER_ID=me
# COMPANION_AGENT_ID=companion
# ANTHROPIC_API_KEY=
