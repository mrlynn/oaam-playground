// Used by `npm run typecheck`, not by docusaurus build. It also checks the
// dashboard's pure files the replay imports from ../web/src/lib.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@inspector/lib/*": ["../web/src/lib/*"],
      "@site/*": ["./*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
