# Copy to agent/.env. Model strings are LiteLLM identifiers.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
AIM_LLM_MODEL=anthropic/claude-sonnet-5
AIM_EMBED_MODEL=ollama/nomic-embed-text
# Alternative: openai/text-embedding-3-small (needs OPENAI_API_KEY)
# Optional: namespaces the managed tables (letters/digits/_ , max 16 chars)
AIM_MEMORY_STORE_ID=
