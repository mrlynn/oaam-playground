{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "serve",
        "--",
        "--no-open"
      ],
      "port": 3100,
      "url": "http://localhost:3100"
    },
    {
      "name": "companion",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "companion",
        "run",
        "companion",
        "--web"
      ],
      "port": 8765
    },
    {
      "name": "demo",
      "runtimeExecutable": "./demo.sh",
      "runtimeArgs": [],
      "port": 3000,
      "autoPort": true
    }
  ]
}
