# Copy to web/.env.local. The dashboard logs in as the read-only AIM_WEB user,
# which can SELECT from the AIM_V_* views and nothing else.
AIM_WEB_USER=aim_web
AIM_WEB_PASSWORD=
AIM_DB_DSN=localhost:1521/FREEPDB1
AIM_SCHEMA=AIM_APP
# Where /chat and /docs are proxied (./demo.sh sets both, and AIM_SCHEMA to match the chat).
# COMPANION_URL=http://127.0.0.1:8765
# DOCS_URL=http://127.0.0.1:3101
